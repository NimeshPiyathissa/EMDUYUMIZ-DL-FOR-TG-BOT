# ====================================================================
# Edumix Telegram Bot - Environment Configuration Template
# ====================================================================

# Telegram API Credentials (obtain from https://my.telegram.org)
API_ID=
API_HASH=

# Telegram Bot Token (obtain from @BotFather)
BOT_TOKEN=

# Bot Administrator Telegram User ID(s).
# Supports single ID or comma-separated list (e.g. 123456789,987654321)
ADMIN_ID=

# Initial Authorized User Telegram IDs (optional, comma-separated)
# You can also authorize users at runtime via the /auth command
AUTH_USERS=

# ====================================================================
# Optional Advanced Settings
# ====================================================================

# Custom executable paths (defaults to system PATH / venv)
# YTDLP_PATH=yt-dlp
# MP4DECRYPT_PATH=mp4decrypt

# Custom User-Agent header for HTTP requests and stream fetching
# BROWSER_UA=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36
